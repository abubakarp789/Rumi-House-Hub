# For local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/rumi_house_hub

# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rumi_house_hub?retryWrites=true&w=majority

# Optional connection pool size
MONGODB_MAX_POOL_SIZE=10

# JWT Token Secret Key
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Express Port Configuration
PORT=5000

# Environment Mode
NODE_ENV=development
